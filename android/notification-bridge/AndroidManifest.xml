<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.echo.accounts.notifications" android:versionCode="2" android:versionName="0.2">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <application android:label="Echo 通知桥" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".Listener" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
